        </mxCell>
        <mxCell id="t2_7_1" parent="lane_pm_7_1" value="&lt;b&gt;2. Input Release Details&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#333;&quot;&gt;Specify Effective Release Date&lt;br/&gt;and input mandatory release reason&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#000000;align=center;verticalAlign=middle;shadow=0;spacing=3;" vertex="1">
