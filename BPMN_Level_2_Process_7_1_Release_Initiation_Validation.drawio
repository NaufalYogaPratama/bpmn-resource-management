        </mxCell>
        <mxCell id="t3_7_1" parent="lane_pm_7_1" value="&lt;b&gt;3. Click Submit Release&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#333;&quot;&gt;Trigger client-side offboarding&lt;br/&gt;date boundary validations&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#000000;align=center;verticalAlign=middle;shadow=0;spacing=3;" vertex="1">
          <mxGeometry x="470" y="80" width="140" height="66" as="geometry" />
        </mxCell>
        <mxCell id="t_fix_7_1" parent="lane_pm_7_1" value="&lt;b&gt;Adjust Release Parameters&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#333;&quot;&gt;Ensure effectiveDate &amp;lt;= endDate&lt;br/&gt;and enter complete reason&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#000000;align=center;verticalAlign=middle;shadow=0;spacing=3;" vertex="1">
