        <mxCell id="t2_4_1" parent="lane_pm_4_1" value="&lt;b&gt;2. Add Resource Items&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#333;&quot;&gt;Select talent from pool,&lt;br/&gt;assign role, set startDate/endDate&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#000000;align=center;verticalAlign=middle;shadow=0;spacing=3;" vertex="1">
