        <mxCell id="t1_4_1" parent="lane_pm_4_1" value="&lt;b&gt;1. Enter Project Metadata&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#333;&quot;&gt;Input Client, Project Name,&lt;br/&gt;&amp;amp; Scope Description&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#000000;align=center;verticalAlign=middle;shadow=0;spacing=3;" vertex="1">
